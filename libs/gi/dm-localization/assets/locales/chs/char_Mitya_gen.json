  "auto": {
    "name": "链式反应",
    "fields": {
      "normal": {
        "0": "<strong>普通攻击</strong>",
        "1": "进行至多三段的攻击，造成<electro>雷元素伤害</electro>。"
      },
      "charged": {
        "0": "<strong>重击</strong>",
        "1": "消耗一定体力，短暂咏唱后，对前方区域造成<electro>雷元素范围伤害</electro>。",
        "2": "若当前场上存在米提亚自己创造的<strong><tooltip ns=tooltips_gen baseKey18=11360002 values=[]>侦测炉心·过载</tooltip></strong>，且米提亚拥有至少一枚<strong><tooltip ns=tooltips_gen baseKey18=11360001 values=[]>递变信标</tooltip></strong>，米提亚将改为进行不消耗体力的特殊重击<strong>递变聚爆</strong>：对前方区域造成一次<electro>雷元素范围伤害</electro>，并在长按时持续消耗<strong>递变信标</strong>；每消耗一枚<strong>递变信标</strong>，都会对前方区域造成一次视为星超导反应伤害的<electro>雷元素范围伤害</electro>。"
      },
      "plunging": {
        "0": "<strong>下落攻击</strong>",
        "1": "从空中下坠冲击地面，攻击下落路径上的敌人，并在落地时造成<electro>雷元素范围伤害</electro>。"
      }
