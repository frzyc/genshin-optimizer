    }
  },
  "constellation1": {
    "name": "寒谷轰雷",
    "description": {
      "0": "队伍中附近的角色对敌人触发<electro>雷元素相关反应</electro>后，将为阿罗夏恢复15点元素能量，该效果每18秒至多触发一次。"
    }
  },
  "constellation2": {
    "name": "长嗥远讯",
    "description": {
      "0": "元素爆发<strong>守猎进踞</strong>的持续时间延长6秒。",
      "1": "此外，<tooltip ns=tooltips_gen baseKey18=11480002 values=[]><strong>图加林</strong></tooltip>每次攻击敌人前，还会为一名目标施加<tooltip ns=tooltips_gen baseKey18=11480001 values=[]><strong>弋猎印记</strong></tooltip>；该效果不会激活已有的<strong>弋猎印记</strong>。"
    }
  },
