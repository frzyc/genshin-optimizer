    }
  },
  "constellation1": {
    "name": "寒谷轟雷",
    "description": {
      "0": "隊伍中附近的角色對敵人觸發<electro>雷元素相關反應</electro>後，將為阿羅夏恢復15點元素能量，該效果每18秒至多觸發一次。"
    }
  },
  "constellation2": {
    "name": "長嗥遠訊",
    "description": {
      "0": "元素爆發<strong>守獵進踞</strong>的持續時間延長6秒。",
      "1": "此外，<tooltip ns=tooltips_gen baseKey18=11480002 values=[]><strong>圖加林</strong></tooltip>每次攻擊敵人前，還會為一名目標施加<tooltip ns=tooltips_gen baseKey18=11480001 values=[]><strong>弋獵印記</strong></tooltip>。該效果不會啟動已有的<strong>弋獵印記</strong>。"
    }
  },
  "constellation3": {
