  "passive1": {
    "name": "驚醒沉睡的林線",
    "description": {
      "0": "<tooltip ns=tooltips_gen baseKey18=11480002 values=[]><strong>圖加林</strong></tooltip>進行攻擊時，還會為隊伍中附近的目前場上角色恢復生命值，回復量相當於阿羅夏攻擊力的120%。"
    }
  },
  "passive2": {
    "name": "告別冬麥與殘葉",
    "description": {
      "0": "基於阿羅夏的元素充能效率，提升阿羅夏的元素戰技與元素爆發造成的傷害：每1%元素充能效率都會使上述傷害提升0.35%，至多提升至70%。"
    }
  },
  "passive3": {
    "name": "星赴險域",
    "description": {
      "0": "處於<tooltip ns=tooltips_gen baseKey18=11330003 values=[]><strong>極星輝域</strong></tooltip>中時，阿羅夏將會進入<strong>輝映·星超導</strong>狀態。",
      "1": "<strong>輝映·星超導</strong>：啟動<tooltip ns=tooltips_gen baseKey18=11480001 values=[]><strong>弋獵印記</strong></tooltip>時獲得的<strong>獵者之準</strong>效果還會使角色處於場上時造成的星超導反應傷害提升20%。"
    }
  },
  "passive": {
    "name": "樹梢察伺",
    "description": {
